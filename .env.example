# Copy to .env for local Supabase function testing. Never commit .env.
#
# Front end (public, safe to expose) -> paste into js/config.js
#   SUPABASE_URL, SUPABASE_ANON_KEY, TURNSTILE_SITE_KEY
#
# Server only -> `supabase secrets set --env-file .env`
# Never put these in js/ or anywhere the browser can load them.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY is injected automatically inside Supabase edge functions.

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated origins allowed to call the edge functions
ALLOWED_ORIGINS=https://dunstonprecan.com,https://www.dunstonprecan.com
SITE_URL=https://dunstonprecan.com
# Flip to true only when the founders open orders
SALES_OPEN=false
